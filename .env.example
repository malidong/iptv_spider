# Bind mounts on the host
HOST_INPUT_DIR=./input
HOST_OUTPUT_DIR=./output
HOST_CACHE_DIR=./cache
HOST_LOG_DIR=./logs

# Container paths used by the app
URL_OR_PATH=https://live.iptv365.org/live.m3u
FILTER=\b(cctv|CCTV)-?(?:[1-9]|1[0-7]|5\+?)\b
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
CACHE_DIR=/data/cache
LOG_DIR=/data/logs
CACHE_FILE=/data/cache/tested_channels.json

# Runtime settings
EPG_URL=http://epg.51zmt.top:8000/e.xml
OUTPUT_WITH_EPG=false
DEDUP_MODE=url_fingerprint
DEDUP_KEEP=first
CACHE_ENABLED=true
CACHE_TTL_HOURS=24
CACHE_CLEAR=false
SPEED_THRESHOLD_MB=0.3
SPEED_LIMIT_MB=2
MAX_RETRIES=3
REQUEST_TIMEOUT=30
PROBE_TIMEOUT=10
LOG_LEVEL=INFO

# Future scheduler placeholders
SCHEDULER_ENABLED=false
SCHEDULE_CRON=
SCHEDULE_TIMEZONE=Asia/Tokyo
